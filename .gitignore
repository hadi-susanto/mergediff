# Build output
/bin/
*.exe
*.test
*.out
coverage.*

# Wails / Task state
/.task/
/.wails/

# Frontend
/frontend/node_modules/
# Vite output; .gitkeep stays so //go:embed all:frontend/dist compiles on a
# fresh clone (Vite restores it from frontend/public/.gitkeep on every build).
/frontend/dist/*
!/frontend/dist/.gitkeep

# Release packaging
/dist/

# Editors / OS
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db
__pycache__/

# Compiled from build/appicon.icon by actool (macOS, Xcode 26+) during the build
/build/darwin/Assets.car
