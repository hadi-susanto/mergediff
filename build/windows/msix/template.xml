    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="mergediff"
        Arguments=""
        InstallLocation="C:\Program Files\Hadi Susanto Lesmana\mergediff">
    </Installer>
    <PackageInformation
        PackageName="mergediff"
        PackageDisplayName="mergediff"
